---
/**
 * Ingredients: grouped Markdown-style lists with native checkboxes and a
 * servings adjuster. Quantities live in <data value> so the client script
 * can rescale them; the initial text is rendered by the same formatter.
 */
import Icon from '../ui/Icon.astro';
import PhotoFigure from './PhotoFigure.astro';
import { siteConfig } from '../../config/site';
import type { Recipe } from '../../data/types';
import type { Locale } from '../../i18n/config';
import { fmt, useTranslations } from '../../i18n/translations';
import { formatQuantity } from '../../lib/quantity';

interface Props {
  recipe: Recipe;
  locale: Locale;
}
const { recipe, locale } = Astro.props;
const t = useTranslations(locale);
const s = t.recipe.servings;
const totalItems = recipe.t.ingredientGroups.reduce((n, g) => n + g.items.length, 0);
const { min, max } = siteConfig.recipes.servings;
---

<section id="ingredients" aria-labelledby="ingredients-title" class="scroll-mt-28" data-ingredients data-base-servings={recipe.servings} data-locale={locale}>
  <h2 id="ingredients-title">{t.recipe.sections.ingredients}</h2>
  {recipe.t.yieldNote && <p class="text-base text-ink-muted">{recipe.t.yieldNote}</p>}

  <div class="servings-bar" data-print="hide">
    <div class="flex items-center gap-2" role="group" aria-labelledby="servings-label">
      <label id="servings-label" for="servings-input" class="mr-1 text-sm font-bold">{s.label}</label>
      <button type="button" class="btn btn-outline btn-icon btn-sm" data-servings-step="-1" aria-label={s.decrease}>
        <Icon name="minus" size={16} />
      </button>
      <input
        id="servings-input"
        type="number"
        inputmode="numeric"
        min={min}
        max={max}
        step="1"
        value={recipe.servings}
        class="field w-16 text-center font-mono font-bold"
        style="min-block-size: var(--button-height-sm)"
        data-servings-input
      />
      <button type="button" class="btn btn-outline btn-icon btn-sm" data-servings-step="1" aria-label={s.increase}>
        <Icon name="plus" size={16} />
      </button>
      <button type="button" class="btn btn-sm ml-1 text-ink-muted underline" data-servings-reset hidden>{s.reset}</button>
    </div>
    <p class="text-sm text-ink-muted" data-check-progress data-template={t.recipe.ingredientsProgress} data-total={totalItems}>
      {fmt(t.recipe.ingredientsProgress, { done: 0, total: totalItems })}
    </p>
  </div>
  <p class="sr-only" role="status" data-servings-status data-template={s.scaledNote}></p>
  <p class="text-sm text-ink-muted" data-print="hide">{t.recipe.ingredientsHint}</p>

  {
    recipe.t.ingredientGroups.map((group, g) => (
      <>
        <h3 id={`ingredients-${g}`}>{group.title}</h3>
        <ul class="ingredient-list" aria-labelledby={`ingredients-${g}`}>
          {group.items.map((item, i) => {
            const id = `ing-${g}-${i}`;
            return (
              <li>
                <input type="checkbox" id={id} data-ingredient-check />
                <label for={id}>
                  <span class="ing-text">
                    {item.amount !== undefined && (
                      <>
                        <data class="qty" value={item.amount} data-unit={item.unit ?? ''}>
                          {formatQuantity(item.amount, item.unit, locale)}
                        </data>{' '}
                      </>
                    )}
                    <span class="name">{item.name}</span>
                    {item.note && <span class="note">, {item.note}</span>}
                  </span>
                </label>
              </li>
            );
          })}
        </ul>
      </>
    ))
  }

  <PhotoFigure image={recipe.t.images.ingredients} locale={locale} sizes="(min-width: 64rem) 780px, 92vw" widths={[480, 780, 1200, 1560]} frameClass="aspect-cinema" />
</section>

<style>
  .servings-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .ingredient-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-border);
  }
  .ingredient-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-2xs);
    border-block-end: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);
  }
  .ingredient-list li:hover {
    background: var(--color-surface-sunken);
  }
  .ingredient-list label {
    flex: 1;
    cursor: pointer;
    font-size: var(--text-base);
  }
  .ingredient-list .qty {
    font-family: var(--font-mono);
    font-size: 0.92em;
    font-weight: var(--weight-bold);
    color: var(--color-accent-strong);
    white-space: nowrap;
  }
  .ingredient-list .note {
    color: var(--color-text-secondary);
  }

  /* ---------- Custom checkbox with a drawn-in check ---------- */
  .ingredient-list input {
    appearance: none;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin: 0.2em 0 0;
    border: 2px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
  }
  .ingredient-list input::before {
    content: '';
    inline-size: 0.7rem;
    block-size: 0.7rem;
    background: var(--color-accent-contrast);
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0, 43% 62%);
    scale: 0;
  }
  .ingredient-list input:checked {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }
  .ingredient-list input:checked::before {
    scale: 1;
  }
  .ingredient-list input:hover:not(:checked) {
    border-color: var(--color-accent);
  }

  /*
    Strike-through drawn left to right: a 2px gradient line whose width grows
    from 0 to 100%. On an inline element it sweeps across wrapped lines too.
  */
  .ing-text {
    background: linear-gradient(var(--color-accent), var(--color-accent)) no-repeat 0 58% / 0 2px;
  }
  .ingredient-list li:has(input:checked) .ing-text {
    background-size: 100% 2px;
    color: var(--color-text-secondary);
  }
  .ingredient-list li:has(input:checked) .qty,
  .ingredient-list li:has(input:checked) .note {
    color: inherit;
  }

  /*
    Motion only after the saved checklist has been restored ([data-checklist-ready]
    is set by the script), so restored items don't all animate on page load.
  */
  @media (prefers-reduced-motion: no-preference) {
    [data-checklist-ready] .ingredient-list input {
      transition:
        background-color 200ms ease,
        border-color 200ms ease;
    }
    [data-checklist-ready] .ingredient-list input::before {
      transition: scale 300ms cubic-bezier(0.34, 1.56, 0.64, 1) 60ms;
    }
    [data-checklist-ready] .ingredient-list input:checked {
      animation: check-pop 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    [data-checklist-ready] .ing-text {
      transition:
        background-size 450ms cubic-bezier(0.65, 0, 0.35, 1),
        color 300ms ease;
    }
    [data-checklist-ready] .ingredient-list li:has(input:checked) {
      animation: row-flash 700ms ease-out;
    }
    [data-checklist-ready] [data-check-progress][data-complete] {
      animation: done-pop 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
  @keyframes check-pop {
    0% { scale: 1; }
    40% { scale: 0.8; }
    75% { scale: 1.15; }
    100% { scale: 1; }
  }
  @keyframes row-flash {
    0% { background-color: color-mix(in srgb, var(--color-accent) 22%, transparent); }
    100% { background-color: transparent; }
  }
  @keyframes done-pop {
    50% { scale: 1.12; }
  }

  /* Everything gathered: the counter turns into a little celebration. */
  [data-check-progress][data-complete] {
    color: var(--color-tip);
    font-weight: var(--weight-bold);
    transform-origin: right center;
  }
  [data-check-progress][data-complete]::before {
    content: '✓ ';
  }
</style>
