---
import Icon from '../ui/Icon.astro';
import type { Recipe } from '../../data/types';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';

interface Props {
  recipe: Recipe;
  locale: Locale;
}
const { recipe, locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="faq" aria-labelledby="faq-title" class="scroll-mt-28">
  <h2 id="faq-title">{t.recipe.sections.faq}</h2>
  <div class="faq">
    {
      recipe.t.faq.map((f, i) => (
        <details name="recipe-faq" open={i === 0}>
          <summary>
            <span>{f.question}</span>
            <Icon name="plus" size={18} class="faq-icon" />
          </summary>
          <p>{f.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    border-block-start: 1px solid var(--color-border);
  }
  details {
    border-block-end: 1px solid var(--color-border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-3xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--color-accent-strong);
  }
  /* :global — the svg is rendered by <Icon>, outside this component's scope. */
  .faq :global(.faq-icon) {
    flex-shrink: 0;
    color: var(--color-accent-strong);
    transition: rotate var(--transition-base);
  }
  details[open] :global(.faq-icon) {
    rotate: 135deg;
  }
  details p {
    margin: 0;
    padding: 0 var(--space-3xs) var(--space-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
  }
  /*
    Open/close animation, no JS: ::details-content is the box holding
    everything after <summary>; interpolate-size lets its height transition
    to/from "auto". Browsers without ::details-content just open instantly.
  */
  @media (prefers-reduced-motion: no-preference) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 400ms cubic-bezier(0.65, 0, 0.35, 1),
        content-visibility 400ms allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
    }
    details p {
      opacity: 0;
      translate: 0 -0.5rem;
      transition:
        opacity 300ms ease,
        translate 400ms cubic-bezier(0.34, 1.3, 0.64, 1);
    }
    details[open] p {
      opacity: 1;
      translate: 0 0;
      transition-delay: 80ms;
    }
    summary {
      transition: color var(--transition-fast), padding-inline-start var(--transition-base);
    }
    details[open] summary {
      padding-inline-start: var(--space-2xs);
    }
  }

  @media print {
    details::details-content {
      block-size: auto;
    }
    details p {
      opacity: 1;
      translate: none;
    }
    details:not([open]) p {
      display: block;
    }
  }
</style>
