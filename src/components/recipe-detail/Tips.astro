---
import Icon, { type IconName } from '../ui/Icon.astro';
import type { CalloutType, Recipe } from '../../data/types';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';

interface Props {
  recipe: Recipe;
  locale: Locale;
}
const { recipe, locale } = Astro.props;
const t = useTranslations(locale);
const icons: Record<CalloutType, IconName> = {
  chef: 'chef',
  mistake: 'alert',
  substitution: 'swap',
  storage: 'box',
  warning: 'info',
};
---

<section id="tips" aria-labelledby="tips-title" class="scroll-mt-28">
  <h2 id="tips-title">{t.recipe.sections.tips}</h2>
  <ul class="m-0 grid list-none gap-4 p-0">
    {
      recipe.t.callouts.map((c) => (
        <li class="callout" data-type={c.type}>
          <p class="callout-title">
            <Icon name={icons[c.type]} size={15} />
            {t.recipe.callouts[c.type]}
          </p>
          <p>{c.text}</p>
        </li>
      ))
    }
  </ul>
</section>
