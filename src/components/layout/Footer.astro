---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import { siteConfig } from '../../config/site';
import { categoryTiles } from '../../data/categories';
import type { Locale } from '../../i18n/config';
import { localizePath } from '../../i18n/routing';
import { fmt, useTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const recipesUrl = localizePath(locale, '/recipes');
const linkClass = 'text-ink-muted no-underline hover:text-ink hover:underline';
---

<footer data-site-footer class="mt-(--space-xl) border-t border-line bg-sunken">
  <div class="shell grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
    <section aria-labelledby="footer-brand">
      <h2 id="footer-brand" class="sr-only">{siteConfig.brand.name}</h2>
      <Logo locale={locale} size="lg" />
      <p class="mt-4 max-w-xs font-serif text-lg text-ink italic">{siteConfig.brand.tagline[locale]}</p>
      <p class="mt-3 max-w-sm text-sm text-ink-muted">{t.footer.blurb}</p>
    </section>

    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore" class="kicker mb-4">{t.footer.explore}</h2>
      <ul class="space-y-2 text-sm">
        <li><a class={linkClass} href={localizePath(locale, '/')}>{t.nav.home}</a></li>
        <li><a class={linkClass} href={recipesUrl}>{t.nav.recipes}</a></li>
        <li><a class={linkClass} href={`${localizePath(locale, '/')}#about`}>{t.nav.about}</a></li>
        <li><a class={linkClass} href={`${recipesUrl}#recipe-search`}>{t.nav.search}</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-categories">
      <h2 id="footer-categories" class="kicker mb-4">{t.footer.categories}</h2>
      <ul class="space-y-2 text-sm">
        {
          categoryTiles.map((c) => (
            <li>
              <a class={linkClass} href={`${recipesUrl}?${c.query}`}>
                {c.label[locale]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="space-y-8">
      <section aria-labelledby="footer-language">
        <h2 id="footer-language" class="kicker mb-4">{t.footer.language}</h2>
        <LanguageSwitcher locale={locale} pathname={Astro.url.pathname} variant="full" />
      </section>
      <section aria-labelledby="footer-social">
        <h2 id="footer-social" class="kicker mb-4">{t.footer.social}</h2>
        <ul class="flex gap-2" role="list">
          {
            siteConfig.brand.social.map((s) => (
              <li>
                <span class="social-icon btn btn-outline btn-icon" role="img" aria-label={s.label} title={s.label}>
                  <Icon name={s.id as IconName} />
                </span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="shell flex flex-col gap-3 py-6 text-xs text-ink-muted md:flex-row md:items-center md:justify-between">
      <p><small class="text-xs">{fmt(t.footer.copyright, { year })}</small></p>
      <p class="max-w-2xl md:text-center"><small class="text-xs">{t.footer.credits}</small></p>
      <a href="#top" class="inline-flex items-center gap-1 self-start font-semibold text-ink no-underline hover:underline md:self-auto">
        <Icon name="arrowUp" size={14} />
        {t.footer.backToTop}
      </a>
    </div>
  </div>
</footer>

<style>
  /* Decorative brand icons, not links: no pointer or hover affordance. */
  .social-icon {
    cursor: default;
  }
  .social-icon:hover {
    background: transparent;
    border-color: var(--color-border-strong);
  }
</style>
