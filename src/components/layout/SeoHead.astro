---
/**
 * Everything search engines and social networks read: title, description,
 * canonical, hreflang alternates, Open Graph, Twitter Card and JSON-LD.
 */
import { siteConfig } from '../../config/site';
import { localeMeta, locales, type Locale } from '../../i18n/config';
import { absoluteUrl, getAlternates, localizePath } from '../../i18n/routing';

export interface SeoProps {
  locale: Locale;
  /** Page title without the brand suffix. Omit to use `fullTitle` as-is. */
  title?: string;
  fullTitle?: string;
  description: string;
  /** Locale-agnostic path, e.g. `/recipes/brigadeiro` (or `/` for home). */
  path: string;
  /** Absolute URL of a social preview image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Absolute canonical URL override (defaults to the localized path). */
  canonical?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  locale,
  title,
  fullTitle,
  description,
  path,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
  canonical: canonicalOverride,
} = Astro.props as SeoProps;

const pageTitle = fullTitle ?? siteConfig.seo.titleTemplate.replace('%s', title ?? siteConfig.brand.name);
const canonical = canonicalOverride ?? absoluteUrl(localizePath(locale, path));
const alternates = getAlternates(path);
const ogImage = image ?? absoluteUrl('/og-default.jpg');
const json = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : siteConfig.seo.robots} />
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:site_name" content={siteConfig.brand.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{
  locales
    .filter((l) => l !== locale)
    .map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)
}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(siteConfig.images.og.width)} />
<meta property="og:image:height" content={String(siteConfig.images.og.height)} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={siteConfig.seo.twitterHandle} />
<meta name="twitter:title" content={title ?? pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={json(data)} />)}
