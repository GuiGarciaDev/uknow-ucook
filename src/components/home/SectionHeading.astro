---
interface Props {
  id: string;
  kicker: string;
  title: string;
  intro?: string;
  align?: 'start' | 'center';
}
const { id, kicker, title, intro, align = 'start' } = Astro.props;
---

<header class:list={['mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between', align === 'center' && 'md:flex-col md:items-center md:text-center']}>
  <div class:list={['max-w-2xl', align === 'center' && 'mx-auto']}>
    <p class="kicker">{kicker}</p>
    <h2 id={id} class="section-title mt-3">{title}</h2>
    {intro && <p class="mt-3 text-ink-muted">{intro}</p>}
  </div>
  <slot />
</header>
