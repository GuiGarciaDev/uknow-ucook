---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { categoryTiles } from '../../data/categories';
import type { Recipe } from '../../data/types';
import type { Locale } from '../../i18n/config';
import { localizePath } from '../../i18n/routing';
import { fmt, useTranslations } from '../../i18n/translations';

interface Props {
  locale: Locale;
  recipes: Recipe[];
}
const { locale, recipes } = Astro.props;
const t = useTranslations(locale).home.categories;
const base = localizePath(locale, '/recipes');

/** Count matches for each tile using the same rules as the filter page. */
function countFor(query: string): number {
  const params = new URLSearchParams(query);
  return recipes.filter((r) => {
    const c = params.get('category');
    const d = params.get('diet');
    const cu = params.get('cuisine');
    const max = params.get('maxTotal');
    return (
      (!c || r.categories.includes(c as Recipe['categories'][number])) &&
      (!d || r.diets.includes(d as Recipe['diets'][number])) &&
      (!cu || r.cuisines.includes(cu as Recipe['cuisines'][number])) &&
      (!max || r.totalMinutes <= Number(max))
    );
  }).length;
}

const tiles = categoryTiles.map((tile) => ({
  ...tile,
  count: countFor(tile.query),
  image: recipes.find((r) => r.slug === tile.imageFrom)?.t.images.hero.src,
}));
---

<section aria-labelledby="categories-title" class="bg-card-muted/50 py-(--space-3xl)">
  <div class="shell">
    <SectionHeading id="categories-title" kicker={t.kicker} title={t.title} intro={t.intro} />
    <!--
      Phones: a horizontal, snap-centred strip (8 tall tiles stacked 4 rows
      deep was a long scroll). From md up: the editorial bento grid.
    -->
    <ul class="cat-list scrollbar-none gap-4 md:grid md:grid-cols-4" role="list">
      {
        tiles.map((tile, i) => (
          <li class:list={['cat-item', [0, 5, 6, 7].includes(i) ? 'md:col-span-2' : '']} data-reveal="zoom" style={`--reveal-i: ${i % 4}`}>
            <a
              href={`${base}?${tile.query}`}
              class="cat-tile group relative flex aspect-[4/5] items-end overflow-hidden rounded-tile no-underline shadow-tile md:aspect-auto md:h-64"
            >
              {tile.image && (
                <Picture
                  src={tile.image}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[320, 640]}
                  sizes="(min-width: 48rem) 25vw, 50vw"
                  quality={siteConfig.images.quality}
                  loading="lazy"
                  class="media-zoom absolute inset-0 h-full w-full object-cover"
                />
              )}
              <span class="tile-scrim absolute inset-0" aria-hidden="true" />
              <span class="relative flex w-full flex-col gap-0.5 p-4 text-on-media">
                <span class="font-serif text-2xl leading-tight font-bold md:text-3xl">{tile.label[locale]}</span>
                <span class="text-sm opacity-90">{tile.blurb[locale]}</span>
                <span class="mt-2 text-xs font-semibold tracking-wide uppercase opacity-80">
                  {tile.count === 0 ? t.countZero : tile.count === 1 ? t.countOne : fmt(t.count, { count: tile.count })}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @media (max-width: 47.999rem) {
    .cat-list {
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* Bleed to the screen edges, and pad so the first/last tile can centre. */
      margin-inline: calc(var(--layout-gutter) * -1);
      padding: var(--space-xs) 16%;
      scroll-padding-inline: 16%;
    }
    .cat-item {
      flex: 0 0 68%;
      scroll-snap-align: center;
    }
    /* The entry reveal is a vertical effect; the strip has its own motion. */
    .cat-item[data-reveal] {
      animation: none;
    }
  }

  /*
    Scroll-linked along the strip: each tile's progress through the
    scroller's width drives its size, so the centred tile is full-size and
    its neighbours recede.
  */
  @supports (animation-timeline: view()) {
    @media (max-width: 47.999rem) and (prefers-reduced-motion: no-preference) {
      .cat-tile {
        animation: tile-focus linear both;
        animation-timeline: view(inline);
      }
    }
  }
  @keyframes tile-focus {
    0%,
    100% {
      scale: 0.86;
      opacity: 0.6;
    }
    50% {
      scale: 1;
      opacity: 1;
    }
  }

  .tile-scrim {
    background: linear-gradient(to top, var(--color-media-scrim), transparent 65%);
  }
</style>
