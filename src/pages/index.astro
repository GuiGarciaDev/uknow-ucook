---
/**
 * `/` — resolves the best locale on the client (saved choice → browser
 * languages → en-US) and redirects. Without JS, visitors see two links and
 * crawlers follow the hreflang alternates.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/layout/Logo.astro';
import { siteConfig } from '../config/site';
import { defaultLocale, localeMeta, locales } from '../i18n/config';
import { localizePath } from '../i18n/routing';
import { useTranslations } from '../i18n/translations';

const t = useTranslations(defaultLocale);
const config = {
  key: siteConfig.i18n.storageKey,
  locales: locales.map((l) => ({ id: l, primary: localeMeta[l].matches })),
  fallback: defaultLocale,
};
---

<BaseLayout
  locale={defaultLocale}
  fullTitle={`${siteConfig.brand.name} — ${siteConfig.brand.tagline[defaultLocale]}`}
  description={t.meta.homeDescription}
  path="/"
  canonical={new URL('/', siteConfig.seo.siteUrl).href}
  bare
>
  <script slot="head" is:inline define:vars={{ config }}>
    // Inline on purpose: must run before anything renders.
    (function () {
      var saved = null;
      try { saved = localStorage.getItem(config.key); } catch (e) {}
      var pick = null;
      config.locales.forEach(function (l) { if (l.id === saved) pick = l.id; });
      if (!pick) {
        var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        for (var i = 0; i < langs.length && !pick; i++) {
          var tag = String(langs[i]).toLowerCase();
          config.locales.forEach(function (l) {
            if (!pick && (tag === l.id.toLowerCase() || l.primary.indexOf(tag.split('-')[0]) !== -1)) pick = l.id;
          });
        }
      }
      location.replace('/' + (pick || config.fallback) + location.search + location.hash);
    })();
  </script>
  <noscript slot="head"><meta http-equiv="refresh" content={`0; url=${localizePath(defaultLocale, '/')}`} /></noscript>

  <div class="grid min-h-dvh place-items-center p-6 text-center">
    <div>
      <Logo locale={defaultLocale} size="lg" />
      <h1 class="mt-8 font-serif text-3xl font-bold">{t.root.title}</h1>
      <p class="mt-2 text-ink-muted">{t.root.redirecting}</p>
      <ul class="mt-6 flex justify-center gap-3">
        {
          locales.map((l) => (
            <li>
              <a class="btn btn-outline" href={localizePath(l, '/')} hreflang={localeMeta[l].htmlLang} lang={localeMeta[l].htmlLang} data-locale-link={l}>
                {localeMeta[l].nativeName}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
