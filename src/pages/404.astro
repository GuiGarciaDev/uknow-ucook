---
import NotFound from '../components/NotFound.astro';
import { defaultLocale } from '../i18n/config';
import { getLocaleFromPath } from '../i18n/routing';

// Built as /404.html for URLs outside a locale (default language). The dev
// server renders this page for every missing URL, so it reads the locale
// from the requested path there; production uses /<locale>/404 instead.
const locale = getLocaleFromPath(Astro.url.pathname) ?? defaultLocale;
---

<NotFound locale={locale} />
